@page
@model EmporioGege.Pages.Auth.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <partial name="_Head" />
    <title>Entrar · PendurAi</title>
</head>
<body>
    <div class="auth-shell has-aside">
        <div class="auth-main">
            <div class="auth-top">
                <a asp-page="/Index" class="brand-lockup"><img src="~/img/brand/pendurai-mark.svg" width="28" height="28" alt="" /> <span>Pendur<span class="text-warning">Ai</span></span></a>
                <button type="button" class="icon-btn" data-pa-theme-toggle aria-label="Alternar tema"><i data-pa-theme-icon class="bi bi-sun"></i></button>
            </div>

            <div class="auth-center">
                <main class="auth-card">
                    <h1>Entrar</h1>
                    <p class="lead-sm">Acesse o caixa e a gestão da sua loja.</p>

                    @if (!string.IsNullOrEmpty(Model.MensagemErro))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@Model.MensagemErro
                        </div>
                    }

                    <form method="post" novalidate>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" type="email" class="form-control" autocomplete="email" autofocus />
                            <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <label asp-for="Senha" class="form-label">Senha</label>
                                <a asp-page="/Auth/EsqueciSenha" class="small">Esqueci minha senha</a>
                            </div>
                            <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Senha" class="invalid-feedback d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 py-2">Entrar</button>
                    </form>

                    <p class="mt-4 mb-0 small text-muted">
                        Ainda não tem conta? <a asp-page="/CadastroLoja">Teste grátis por 7 dias</a>
                    </p>
                </main>
            </div>

            <a asp-page="/Index" class="link-muted"><i class="bi bi-arrow-left me-1"></i> Voltar para o site</a>
        </div>

        <aside class="auth-aside" aria-hidden="true">
            <img src="~/img/produto-painel.png" alt="" loading="lazy" />
            <div class="auth-aside-copy">
                <h2 class="h4 mb-2">Caixa, estoque e fiado no mesmo lugar.</h2>
                <p>Cada venda baixa o estoque e atualiza o caixa ou a conta do cliente numa única operação.</p>
            </div>
        </aside>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/pendurai.js" asp-append-version="true"></script>
</body>
</html>
