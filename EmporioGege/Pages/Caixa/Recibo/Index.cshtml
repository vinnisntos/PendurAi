@page "{id:guid}"
@model EmporioGege.Pages.Caixa.Recibo.IndexModel
@{
    Layout = null;
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var forma = Rotulos.FormaPagamento(Model.Venda.MetodoPagamento);
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Recibo</title>
    <style>
        @@page { size: 80mm auto; margin: 3mm; }
        * { box-sizing: border-box; }
        body { font: 12px/1.35 ui-monospace, Consolas, "Courier New", monospace; color: #000; background: #fff; margin: 0; width: 74mm; }
        h1 { font-size: 14px; text-align: center; margin: 0 0 2px; }
        .centro { text-align: center; }
        .linha { border-top: 1px dashed #000; margin: 6px 0; }
        table { width: 100%; border-collapse: collapse; }
        td { padding: 1px 0; vertical-align: top; }
        .dir { text-align: right; white-space: nowrap; }
        .total td { font-weight: 700; font-size: 14px; }
        .pequeno { font-size: 10px; }
        @@media screen { body { margin: 16px auto; } }
    </style>
</head>
<body>
    <h1>@Model.NomeLoja</h1>
    <div class="centro">@FusoHorarioBrasil.ParaLocal(Model.Venda.DataVenda).ToString("dd/MM/yyyy HH:mm")</div>
    @if (!string.IsNullOrEmpty(Model.Venda.NumeroComanda))
    {
        <div class="centro">Comanda @Model.Venda.NumeroComanda</div>
    }
    <div class="linha"></div>
    <table>
        @foreach (var item in Model.Venda.Itens)
        {
            <tr><td colspan="2">@item.ProdutoNome</td></tr>
            <tr>
                <td class="pequeno">@item.Quantidade x @item.PrecoUnitarioAplicado.ToString("C", br)</td>
                <td class="dir">@item.Subtotal.ToString("C", br)</td>
            </tr>
        }
    </table>
    <div class="linha"></div>
    <table>
        <tr class="total"><td>TOTAL</td><td class="dir">@Model.Venda.TotalVenda.ToString("C", br)</td></tr>
        <tr><td>Pagamento</td><td class="dir">@forma</td></tr>
        @if (!string.IsNullOrEmpty(Model.Venda.ClienteNome))
        {
            <tr><td>Cliente</td><td class="dir">@Model.Venda.ClienteNome</td></tr>
        }
    </table>
    <div class="linha"></div>
    <div class="centro pequeno">Documento sem valor fiscal</div>
    <div class="centro pequeno">Obrigado pela preferência!</div>
    <script nonce="@ViewContext.HttpContext.Items["csp-nonce"]">window.addEventListener("load", function () { window.print(); });</script>
</body>
</html>
