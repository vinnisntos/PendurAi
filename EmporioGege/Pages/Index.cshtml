@page
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <partial name="_Head" />
    <meta name="description" content="PendurAi: sistema de caixa (PDV) e gestão para adegas e mercados de bebidas. Estoque, turno de caixa, fiado e comandas num só lugar. Teste grátis por 7 dias." />
    <meta property="og:title" content="PendurAi · Caixa e gestão para adegas" />
    <meta property="og:description" content="Estoque, turno de caixa, fiado e comandas num só sistema. Teste grátis por 7 dias." />
    <meta property="og:image" content="https://pendurai.vinnisantos.com.br/img/produto-painel.png" />
    <title>PendurAi · Caixa e gestão para adegas e mercados</title>
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <script nonce="@ViewContext.HttpContext.Items["csp-nonce"]">document.documentElement.classList.add("js");</script>
</head>
<body class="lp">

    <header class="lp-nav">
        <div class="lp-container lp-nav-inner">
            <a href="#inicio" class="brand-lockup"><span class="app-brand-mark" aria-hidden="true">P</span> PendurAi</a>
            <nav class="lp-nav-links" aria-label="Seções">
                <a href="#recursos">Recursos</a>
                <a href="#tecnologia">Como funciona</a>
                <a href="#planos">Planos</a>
                <a href="#desenvolvedor">Quem fez</a>
                <a href="#contato">Contato</a>
            </nav>
            <div class="lp-nav-actions">
                <button type="button" class="icon-btn" data-pa-theme-toggle aria-label="Alternar tema"><i data-pa-theme-icon class="bi bi-sun"></i></button>
                <a asp-page="/Auth/Login" class="btn btn-sm btn-outline-secondary">Entrar</a>
            </div>
        </div>
    </header>

    <main>
        <section class="lp-hero" id="inicio">
            <div class="lp-container lp-hero-grid">
                <div class="lp-hero-copy">
                    <h1>Caixa, estoque e fiado <em>num só lugar.</em></h1>
                    <p class="lp-hero-sub">O sistema da sua adega: venda rápida no balcão, turno conferido no fechamento e o fiado de cada cliente em dia.</p>
                    <div class="lp-hero-ctas">
                        <a asp-page="/CadastroLoja" asp-route-plano="pro" class="btn btn-warning">Testar grátis por 7 dias</a>
                        <a href="#planos" class="btn btn-outline-secondary">Ver planos</a>
                    </div>
                </div>
                <div class="lp-shot">
                    <img class="only-dark" src="~/img/produto-pdv-dark.png" width="1440" height="640" alt="Tela da frente de caixa do PendurAi com dois produtos no carrinho e total de R$ 66,78" fetchpriority="high" />
                    <img class="only-light" src="~/img/produto-pdv-light.png" width="1440" height="640" alt="Tela da frente de caixa do PendurAi com dois produtos no carrinho e total de R$ 66,78" loading="lazy" />
                </div>
            </div>
        </section>

        <section class="lp-section" id="recursos">
            <div class="lp-container">
                <h2 class="reveal">Feito para o giro do balcão e para o fechamento do mês.</h2>
                <p class="lp-lead reveal">Cada parte do sistema resolve uma rotina real de adega ou mercado de bebidas.</p>

                <div class="lp-bento">
                    <article class="lp-cell span-2 is-media reveal">
                        <i class="bi bi-box-seam lp-ico" aria-hidden="true"></i>
                        <h3>Estoque que entende caixa e unidade</h3>
                        <p>Vendeu um fardo com 12? O sistema baixa as 12 latas sozinho e guarda o histórico de cada entrada, venda e ajuste.</p>
                        <div class="lp-cell-img">
                            <img class="only-dark" src="~/img/produto-estoque-dark.png" width="1076" height="324" alt="Lista de produtos com preço e estoque atual" loading="lazy" />
                            <img class="only-light" src="~/img/produto-estoque-light.png" width="1076" height="324" alt="Lista de produtos com preço e estoque atual" loading="lazy" />
                        </div>
                    </article>
                    <article class="lp-cell is-accent reveal">
                        <i class="bi bi-safe lp-ico" aria-hidden="true"></i>
                        <h3>Caixa cego</h3>
                        <p>O operador conta a gaveta sem ver o valor esperado. Sangrias e suprimentos ficam registrados, e a diferença aparece no fechamento.</p>
                    </article>
                    <article class="lp-cell reveal">
                        <i class="bi bi-journal-bookmark lp-ico" aria-hidden="true"></i>
                        <h3>Fiado com limite</h3>
                        <p>Limite de crédito por cliente, saldo devedor atualizado a cada compra e baixa parcial ou total do pagamento.</p>
                    </article>
                    <article class="lp-cell reveal">
                        <i class="bi bi-receipt lp-ico" aria-hidden="true"></i>
                        <h3>Comandas</h3>
                        <p>Abra por mesa ou cliente, lance os itens durante o atendimento e feche direto em venda. Sem papel avulso.</p>
                    </article>
                    <article class="lp-cell reveal">
                        <i class="bi bi-bar-chart-line lp-ico" aria-hidden="true"></i>
                        <h3>Relatórios</h3>
                        <p>Faturamento do dia, da semana e do mês, mais vendidos e extrato de vendas. Exporte em Excel, PDF ou CSV.</p>
                    </article>
                    <article class="lp-cell span-3 is-strip reveal">
                        <div>
                            <h3><i class="bi bi-people me-2 text-warning" aria-hidden="true"></i>Equipe com permissões separadas</h3>
                            <p>Vendedor opera o caixa. Administrador vê custos, relatórios e cadastra a equipe. Os dados de cada loja ficam isolados.</p>
                        </div>
                        <a asp-page="/CadastroLoja" asp-route-plano="pro" class="btn btn-outline-secondary">Testar grátis por 7 dias</a>
                    </article>
                </div>
            </div>
        </section>

        <section class="lp-section" id="tecnologia">
            <div class="lp-container lp-split">
                <div class="reveal">
                    <h2>Os números do caixa batem com a conta do cliente.</h2>
                    <p class="lp-lead">Uma aplicação web de verdade, com banco transacional e dados separados por loja desde o primeiro dia.</p>
                </div>
                <div class="lp-facts">
                    <div class="lp-fact reveal">
                        <i class="bi bi-database-check" aria-hidden="true"></i>
                        <h3>Venda numa única operação</h3>
                        <p>Estoque, pedido e caixa (ou fiado) são gravados juntos. Se uma parte falha, nada fica pela metade.</p>
                    </div>
                    <div class="lp-fact reveal">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        <h3>Cada loja isolada</h3>
                        <p>Toda consulta é filtrada pela loja do usuário logado. Uma loja nunca enxerga os dados de outra.</p>
                    </div>
                    <div class="lp-fact reveal">
                        <i class="bi bi-credit-card" aria-hidden="true"></i>
                        <h3>Assinatura automática</h3>
                        <p>Cobrança recorrente pelo Asaas. A licença é liberada ou suspensa conforme o pagamento é confirmado.</p>
                    </div>
                    <div class="lp-fact reveal">
                        <i class="bi bi-printer" aria-hidden="true"></i>
                        <h3>Recibo na térmica</h3>
                        <p>Impressão em impressora térmica ESC/POS, com reimpressão pelo extrato de vendas.</p>
                    </div>
                    <div class="lp-fact reveal">
                        <i class="bi bi-layers" aria-hidden="true"></i>
                        <h3>Regras de negócio no servidor</h3>
                        <p>ASP.NET Core em camadas. Preço, limite de crédito e estoque são validados no servidor, nunca só na tela.</p>
                    </div>
                    <div class="lp-fact reveal">
                        <i class="bi bi-cloud-check" aria-hidden="true"></i>
                        <h3>No ar, com HTTPS</h3>
                        <p>Hospedado em nuvem com domínio e certificado próprios. Acesse do computador do caixa ou do celular.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="lp-section" id="planos">
            <div class="lp-container">
                <div class="lp-eyebrow reveal">7 dias grátis em qualquer plano</div>
                <h2 class="reveal">Um plano para o tamanho da sua loja.</h2>
                <p class="lp-lead reveal">Sem cartão de crédito para começar. Cancele quando quiser.</p>

                <div class="lp-plans">
                    <div class="lp-plan reveal">
                        <div class="lp-plan-head"><span class="lp-plan-name">Start</span></div>
                        <div class="lp-price">R$ 119<small>/mês</small></div>
                        <ul>
                            <li><i class="bi bi-check2"></i>Frente de caixa e comandas</li>
                            <li><i class="bi bi-check2"></i>Estoque e fiado</li>
                            <li><i class="bi bi-check2"></i>1 loja</li>
                        </ul>
                        <a asp-page="/CadastroLoja" asp-route-plano="start" class="btn btn-outline-secondary w-100">Escolher Start</a>
                    </div>
                    <div class="lp-plan is-featured reveal">
                        <div class="lp-plan-head"><span class="lp-plan-name">Pro</span><span class="badge bg-warning">Mais escolhido</span></div>
                        <div class="lp-price">R$ 199<small>/mês</small></div>
                        <ul>
                            <li><i class="bi bi-check2"></i>Tudo do Start</li>
                            <li><i class="bi bi-check2"></i>Relatórios e exportação (Excel, PDF, CSV)</li>
                            <li><i class="bi bi-check2"></i>Vários usuários (administrador e vendedor)</li>
                        </ul>
                        <a asp-page="/CadastroLoja" asp-route-plano="pro" class="btn btn-warning w-100">Escolher Pro</a>
                    </div>
                    <div class="lp-plan reveal">
                        <div class="lp-plan-head"><span class="lp-plan-name">Enterprise</span></div>
                        <div class="lp-price">R$ 349<small>/mês</small></div>
                        <ul>
                            <li><i class="bi bi-check2"></i>Tudo do Pro</li>
                            <li><i class="bi bi-check2"></i>Várias lojas ou redes</li>
                            <li><i class="bi bi-check2"></i>Suporte prioritário</li>
                        </ul>
                        <a asp-page="/CadastroLoja" asp-route-plano="enterprise" class="btn btn-outline-secondary w-100">Escolher Enterprise</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="lp-section" id="desenvolvedor">
            <div class="lp-container">
                <div class="lp-dev reveal">
                    <div class="lp-avatar" aria-hidden="true">VS</div>
                    <div>
                        <h2 class="mb-1" style="font-size: clamp(1.4rem, 2.4vw, 1.8rem);">Vinnicius Gabriel Matos dos Santos</h2>
                        <p class="text-warning fw-medium mb-3">Desenvolvedor full stack, Sorocaba/SP</p>
                        <p class="lp-lead">Estudante de Análise e Desenvolvimento de Sistemas (UNIP), com foco em backend e arquitetura. Antes da tecnologia, trabalhou em ambientes industriais e comerciais, de onde vem a visão prática de processo e logística presente no sistema. O PendurAi foi construído do zero: banco de dados, backend, segurança e deploy.</p>
                        <div class="lp-tags">
                            <span>C# / .NET</span><span>ASP.NET Core</span><span>PostgreSQL</span><span>Supabase</span><span>Docker</span><span>Git</span><span>Linux</span>
                        </div>
                        <div class="lp-links">
                            <a href="https://vinnisantos.com.br" target="_blank" rel="noopener noreferrer"><i class="bi bi-globe2"></i>vinnisantos.com.br</a>
                            <a href="https://github.com/vinnisntos" target="_blank" rel="noopener noreferrer"><i class="bi bi-github"></i>GitHub</a>
                            <a href="https://linkedin.com/in/vinnisantos" target="_blank" rel="noopener noreferrer"><i class="bi bi-linkedin"></i>LinkedIn</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="lp-footer" id="contato">
        <div class="lp-container lp-footer-grid">
            <div>
                <a href="#inicio" class="brand-lockup mb-3"><span class="app-brand-mark" aria-hidden="true">P</span> PendurAi</a>
                <p class="mt-3">&copy; @DateTime.UtcNow.Year PendurAi. Desenvolvido por Vinnicius Santos.</p>
            </div>
            <div class="lp-links">
                <a href="https://wa.me/5515981636193" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp"></i>Falar no WhatsApp</a>
                <a href="https://github.com/vinnisntos" target="_blank" rel="noopener noreferrer"><i class="bi bi-github"></i>GitHub</a>
                <a href="https://linkedin.com/in/vinnisantos" target="_blank" rel="noopener noreferrer"><i class="bi bi-linkedin"></i>LinkedIn</a>
            </div>
        </div>
    </footer>

    <script src="~/js/pendurai.js" asp-append-version="true"></script>
    <script nonce="@ViewContext.HttpContext.Items["csp-nonce"]">
        // Revela blocos ao entrar na tela (CSS já ignora isso com prefers-reduced-motion).
        (function () {
            var itens = document.querySelectorAll(".reveal");
            if (!("IntersectionObserver" in window)) { itens.forEach(function (el) { el.classList.add("is-in"); }); return; }
            var obs = new IntersectionObserver(function (entradas) {
                entradas.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("is-in"); obs.unobserve(e.target); } });
            }, { rootMargin: "0px 0px -10% 0px" });
            itens.forEach(function (el) { obs.observe(el); });
        })();
    </script>
</body>
</html>
