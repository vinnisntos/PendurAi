@page
@model EmporioGege.Pages.Admin.CardapioOnline.IndexModel
@using EmporioGege.Core.Common
@{
    ViewData["Title"] = "Cardápio online";
    var ptBr = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="page-header">
    <div>
        <h1>Cardápio online</h1>
        <p>Página pública do cardápio e atendimento automático pelo WhatsApp, com Pix.</p>
    </div>
    @if (Model.Configuracao.IntegracaoAtiva)
    {
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
            <i class="bi bi-check-circle-fill me-1"></i> Bot conectado
        </span>
    }
    else
    {
        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2">
            <i class="bi bi-exclamation-circle me-1"></i> Bot não configurado
        </span>
    }
</div>

@if (!string.IsNullOrEmpty(Model.MensagemSucesso))
{
    <div class="alert alert-success">@Model.MensagemSucesso</div>
}
@if (!string.IsNullOrEmpty(Model.MensagemErro))
{
    <div class="alert alert-danger">@Model.MensagemErro</div>
}

<div class="card card-custom p-4 mb-4" style="max-width: 720px;">
    <h5 class="text-body-emphasis fw-semibold mb-1">1. Cardápio</h5>
    <p class="text-muted small mb-3">Escolha os produtos em <a href="/Admin/Estoque">Estoque e produtos</a> (editar → "Mostrar no cardápio online").</p>
    <form method="post" asp-page-handler="Salvar">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Slug" class="form-label small text-muted">Endereço do cardápio</label>
                <div class="input-group">
                    <span class="input-group-text">/c/</span>
                    <input asp-for="Slug" class="form-control" placeholder="bolos-da-gabi" />
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="WhatsApp" class="form-label small text-muted">WhatsApp do atendimento</label>
                <input asp-for="WhatsApp" class="form-control" placeholder="(15) 99999-1234" />
            </div>
            <div class="col-12">
                <label asp-for="CallbackUrl" class="form-label small text-muted">Endereço do bot (aviso de Pix pago)</label>
                <input asp-for="CallbackUrl" class="form-control" placeholder="https://bot.seudominio.com.br/webhook/pendurai" disabled="@(!Model.Configuracao.IntegracaoAtiva)" />
                <div class="form-text">Disponível depois de gerar as credenciais do bot (passo 2).</div>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3 align-items-center">
            <button type="submit" class="btn btn-warning fw-semibold px-4">Salvar</button>
            @if (Model.LinkPublico is not null)
            {
                <a href="@Model.LinkPublico" target="_blank" rel="noopener" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-up-right me-1"></i> Abrir cardápio</a>
            }
        </div>
    </form>
</div>

<div class="card card-custom p-4 mb-4" style="max-width: 720px;">
    <h5 class="text-body-emphasis fw-semibold mb-1">2. Credenciais do bot</h5>
    <p class="text-muted small mb-3">Vão no <code>.env</code> do bot: <code>PENDURAI_BASE_URL</code>, <code>PENDURAI_API_TOKEN</code> e <code>PENDURAI_WEBHOOK_SECRET</code>.</p>

    @if (Model.CredenciaisNovas is { } cred)
    {
        <div class="alert alert-warning small">
            <strong>Copie agora:</strong> o token e o segredo não aparecem de novo. Gerar novas credenciais desconecta o bot até você atualizar o <code>.env</code> dele.
        </div>
        <pre class="small p-3 rounded bg-body-tertiary mb-3" style="white-space: pre-wrap; word-break: break-all;">PENDURAI_BASE_URL=@Model.LinkApi
PENDURAI_API_TOKEN=@cred.Token
PENDURAI_WEBHOOK_SECRET=@cred.Segredo</pre>
    }
    else if (Model.Configuracao.IntegracaoAtiva)
    {
        <p class="small mb-3">Token atual termina em <code>…@Model.Configuracao.TokenFinal</code>.</p>
    }

    <form method="post" asp-page-handler="GerarCredenciais">
        <button type="submit" class="btn btn-outline-warning">
            <i class="bi bi-key me-1"></i> @(Model.Configuracao.IntegracaoAtiva ? "Gerar novas credenciais" : "Gerar credenciais")
        </button>
    </form>
</div>

<div class="card card-custom p-3">
    <h5 class="text-body-emphasis fw-semibold mb-3 px-1">Pedidos pelo WhatsApp (últimos @EmporioGege.Pages.Admin.CardapioOnline.IndexModel.DiasPedidos dias)</h5>
    @if (Model.Pedidos.Count == 0)
    {
        <p class="text-muted text-center py-4 mb-0">Nenhum pedido ainda.</p>
    }
    else
    {
        <table class="table table-borderless align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Data/Hora</th>
                    <th>Cliente</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pedidos)
                {
                    var (classe, texto) = p.Status switch
                    {
                        "PAGO" => ("text-success", "Pago"),
                        "PAGO_SEM_ESTOQUE" => ("text-danger", "Pago sem estoque"),
                        "AGUARDANDO_PAGAMENTO" => ("text-warning", "Aguardando Pix"),
                        "EXPIRADO" => ("text-muted", "Expirado"),
                        _ => ("text-danger", "Erro")
                    };
                    <tr>
                        <td class="text-body-emphasis small">@FusoHorarioBrasil.ParaLocal(p.CriadoEm).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@p.ClienteNome <span class="text-muted small d-block">@p.ClienteTelefone</span></td>
                        <td class="@classe small fw-semibold" title="@p.Erro">@texto</td>
                        <td class="text-end">@p.Total.ToString("C", ptBr)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
