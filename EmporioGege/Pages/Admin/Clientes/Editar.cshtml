@page "{id:guid?}"
@model EmporioGege.Pages.Admin.Clientes.EditarModel
@{
    ViewData["Title"] = Model.Id is null ? "Novo Cliente" : "Editar Cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Voltar</a>
</div>

@if (!string.IsNullOrEmpty(Model.MensagemErro))
{
    <div class="alert alert-danger">@Model.MensagemErro</div>
}

<form method="post" class="card card-custom p-4" style="max-width: 560px;">
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Nome" class="form-label small text-muted">Nome</label>
            <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Telefone" class="form-label small text-muted">Telefone (opcional)</label>
            <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
        </div>

        <div class="col-12">
            <label asp-for="CpfRg" class="form-label small text-muted">CPF/RG</label>
            <input asp-for="CpfRg" class="form-control" placeholder="000.000.000-00 ou RG" />
            <span asp-validation-for="CpfRg" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="LimiteCredito" class="form-label small text-muted">Limite de crédito (fiado)</label>
            <input asp-for="LimiteCredito" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="LimiteCredito" class="text-danger small"></span>
        </div>

        @if (Model.Id is not null)
        {
            <div class="col-12">
                <div class="text-muted small">Saldo devedor atual</div>
                <div class="fs-5 @(Model.SaldoDevedorAtual > 0 ? "text-warning" : "text-body-emphasis")">@Model.SaldoDevedorAtual.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</div>
                <div class="form-text text-muted">Ajustado automaticamente por vendas fiado e pagamentos. Não é editável aqui.</div>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-warning fw-semibold px-4">Salvar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@if (Model.Id is not null)
{
    <div class="panel mt-4" style="max-width: 760px;">
        <div class="panel-header"><h2>Pagamentos recebidos</h2></div>
        @if (Model.Pagamentos.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-receipt"></i><strong>Nenhum pagamento ainda</strong>Os recebimentos registrados em Clientes aparecem aqui.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Data</th><th>Forma</th><th>Recebido por</th><th class="text-end">Valor</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Pagamentos)
                        {
                            <tr>
                                <td>@FusoHorarioBrasil.ParaLocal(p.CriadoEm).ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@p.FormaPagamento</td>
                                <td class="text-muted">@(p.UsuarioNome ?? "-")</td>
                                <td class="text-end">@p.Valor.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
