@page
@model EmporioGege.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Visão geral";
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="page-header">
    <div>
        <h1>Visão geral</h1>
        <p>Faturamento, resultado do mês e o que precisa da sua atenção hoje.</p>
    </div>
    <a href="/Admin/Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i> Atualizar</a>
</div>

@if (!string.IsNullOrEmpty(Model.MensagemSucessoAssinatura))
{
    <div class="alert alert-success" role="alert"><i class="bi bi-check-circle me-2"></i>@Model.MensagemSucessoAssinatura</div>
}
@if (!string.IsNullOrEmpty(Model.MensagemErroAssinatura))
{
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@Model.MensagemErroAssinatura</div>
}

@* Status da assinatura: único lugar onde o lojista acompanha trial e cobrança dentro do sistema. *@
@if (Model.Assinatura is { } assinatura)
{
    @if (assinatura.StatusLicenca == "trial")
    {
        var acabando = Model.DiasRestantesTrial <= 2;
        <div class="callout mb-4 @(acabando ? "is-danger" : "")">
            <div>
                <h6><i class="bi bi-stopwatch me-1"></i> Período de teste grátis</h6>
                <p>
                    @if (Model.DiasRestantesTrial > 0)
                    {
                        <text>Faltam <strong>@Model.DiasRestantesTrial dia(s)</strong> de teste. Assine para continuar usando sem interrupção.</text>
                    }
                    else
                    {
                        <text>Seu teste grátis termina hoje. Assine para continuar usando sem interrupção.</text>
                    }
                </p>
            </div>
            <form method="post" asp-page-handler="AssinarAgora">
                <button type="submit" class="btn btn-warning px-4">Assinar agora</button>
            </form>
        </div>
    }
    else if (assinatura.StatusLicenca == "pendente")
    {
        <div class="callout mb-4">
            <div>
                <h6><i class="bi bi-hourglass-split me-1"></i> Aguardando confirmação do pagamento</h6>
                <p>@(string.IsNullOrEmpty(assinatura.AsaasInvoiceUrl)
                        ? "Estamos gerando o link de pagamento. Ele chega por e-mail em instantes."
                        : "Assim que o pagamento for identificado, tudo libera automaticamente.")</p>
            </div>
            @if (!string.IsNullOrEmpty(assinatura.AsaasInvoiceUrl))
            {
                <a href="@assinatura.AsaasInvoiceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-warning px-4">Pagar agora</a>
            }
        </div>
    }
    else if (assinatura.StatusLicenca == "suspenso")
    {
        <div class="callout is-danger mb-4">
            <div>
                <h6><i class="bi bi-exclamation-octagon me-1"></i> Pagamento em atraso</h6>
                <p>@(string.IsNullOrEmpty(assinatura.AsaasInvoiceUrl)
                        ? "Regularize o pagamento para evitar o bloqueio. Fale com o suporte se não recebeu o link de cobrança."
                        : "Regularize agora para evitar o bloqueio do acesso.")</p>
            </div>
            @if (!string.IsNullOrEmpty(assinatura.AsaasInvoiceUrl))
            {
                <a href="@assinatura.AsaasInvoiceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-warning px-4">Pagar agora</a>
            }
        </div>
    }
}

@* Linha 1: operação de hoje *@
<div class="row g-3 mb-3">
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat is-accent">
            <span class="stat-label"><i class="bi bi-cash-stack"></i> Faturamento hoje</span>
            <span class="stat-value">@Model.FaturamentoHoje.ToString("C", br)</span>
            <span class="stat-foot">Semana: <span class="num">@Model.FaturamentoSemana.ToString("C", br)</span> (desde segunda)</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat">
            <span class="stat-label"><i class="bi bi-journal-bookmark"></i> Fiado em aberto</span>
            <span class="stat-value">@Model.FiadoPendenteTotal.ToString("C", br)</span>
            <span class="stat-foot"><a href="/Admin/Clientes">Ver clientes <i class="bi bi-arrow-right"></i></a></span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <div class="stat">
            <span class="stat-label"><i class="bi bi-receipt"></i> Comandas abertas</span>
            <span class="stat-value">@Model.ComandasAtivasContador</span>
            <span class="stat-foot"><a href="/Caixa/Comandas">Abrir comandas <i class="bi bi-arrow-right"></i></a></span>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl-2">
        <div class="stat">
            <span class="stat-label"><i class="bi bi-box-seam"></i> Estoque baixo</span>
            <span class="stat-value @(Model.AlertasEstoqueCritico > 0 ? "text-danger" : "")">@Model.AlertasEstoqueCritico</span>
            <span class="stat-foot"><a href="/Admin/Estoque">Ver produtos <i class="bi bi-arrow-right"></i></a></span>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl-2">
        <div class="stat">
            <span class="stat-label"><i class="bi bi-calendar-x"></i> Vencendo em 30 dias</span>
            <span class="stat-value @(Model.ProdutosProximosValidade.Count > 0 ? "text-warning" : "")">@Model.ProdutosProximosValidade.Count</span>
            <span class="stat-foot">produto(s) com validade próxima</span>
        </div>
    </div>
</div>

<div class="row g-3">
    @* Resultado do mês *@
    <div class="col-12 col-xl-8">
        <div class="panel h-100">
            <div class="panel-header">
                <h2>Resultado do mês</h2>
                <span class="small text-muted">@Model.ResumoMes.TotalVendas venda(s) fechada(s)</span>
            </div>
            <div class="panel-body">
                <div class="row g-4">
                    <div class="col-6 col-md-3">
                        <div class="stat-label mb-1">Faturamento</div>
                        <div class="stat-value fs-4">@Model.ResumoMes.Faturamento.ToString("C", br)</div>
                        <div class="small text-muted mt-1">Inclui vendas no fiado</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-label mb-1">Custo das mercadorias</div>
                        <div class="stat-value fs-4">@Model.ResumoMes.Cmv.ToString("C", br)</div>
                        <div class="small text-muted mt-1">CMV pelo custo médio</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-label mb-1">Lucro bruto</div>
                        <div class="stat-value fs-4 @(Model.ResumoMes.LucroBruto >= 0 ? "text-success" : "text-danger")">@Model.ResumoMes.LucroBruto.ToString("C", br)</div>
                        <div class="small text-muted mt-1">Faturamento menos CMV</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-label mb-1">Margem sobre custo</div>
                        <div class="stat-value fs-4">@(Model.ResumoMes.RoiPercentual is { } roi ? $"{roi:0.0}%" : "-")</div>
                        <div class="small text-muted mt-1">Lucro bruto ÷ CMV</div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="row g-2">
                    <div class="col-12 col-sm-4">
                        <a href="/Admin/Estoque/Editar" class="quick-action"><i class="bi bi-plus-lg"></i> Cadastrar produto</a>
                    </div>
                    <div class="col-12 col-sm-4">
                        <a href="/Admin/Estoque/Entrada" class="quick-action"><i class="bi bi-box-arrow-in-down"></i> Registrar entrada</a>
                    </div>
                    <div class="col-12 col-sm-4">
                        <a href="/Admin/Funcionarios" class="quick-action"><i class="bi bi-person-plus"></i> Adicionar funcionário</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Validade *@
    <div class="col-12 col-xl-4">
        <div class="panel h-100">
            <div class="panel-header">
                <h2>Validade próxima</h2>
                <span class="small text-muted">30 dias</span>
            </div>
            @if (Model.ProdutosProximosValidade.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-check"></i>
                    <strong>Nada vencendo</strong>
                    Nenhum produto com validade nos próximos 30 dias.
                </div>
            }
            else
            {
                <ul class="list-unstyled mb-0 overflow-auto" style="max-height: 320px;">
                    @foreach (var p in Model.ProdutosProximosValidade)
                    {
                        var vencido = p.DiasRestantes < 0;
                        var critico = vencido || p.DiasRestantes <= 7;
                        <li class="d-flex justify-content-between align-items-center gap-2 px-3 py-2 border-bottom">
                            <div class="min-w-0">
                                <div class="small fw-medium text-truncate">@p.Nome</div>
                                <div class="small text-muted">Estoque: <span class="num">@p.EstoqueAtual</span></div>
                            </div>
                            <span class="badge @(critico ? "bg-danger" : "bg-warning") flex-shrink-0">
                                @(vencido ? $"Vencido há {-p.DiasRestantes}d" : $"{p.DiasRestantes}d")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
