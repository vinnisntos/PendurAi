@page
@model EmporioGege.Pages.Admin.Funcionarios.IndexModel
@{
    ViewData["Title"] = "Funcionários";
}

<div class="page-header">
    <div>
        <h1>Funcionários</h1>
        <p>Contas de acesso ao sistema (vendedor/caixa e administrador).</p>
    </div>
    <a asp-page="Editar" class="btn btn-warning fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Novo Funcionário
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.MensagemSucesso))
{
    <div class="alert alert-success">@Model.MensagemSucesso</div>
}
@if (!string.IsNullOrEmpty(Model.MensagemErro))
{
    <div class="alert alert-danger">@Model.MensagemErro</div>
}

<div class="card card-custom p-3">
    @if (Model.Funcionarios.Count == 0)
    {
        <p class="text-muted text-center py-4 mb-0">Nenhum funcionário cadastrado além de você.</p>
    }
    else
    {
        <table class="table table-borderless align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Cargo</th>
                    <th>Status</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Funcionarios)
                {
                    <tr class="@(f.Ativo ? "" : "opacity-50")">
                        <td class="text-body-emphasis fw-medium">@f.Nome</td>
                        <td class="text-muted">@f.Email</td>
                        <td>
                            <span class="badge @(f.Role == "administrador" ? "bg-warning text-dark" : "bg-info text-dark")">
                                @(f.Role == "administrador" ? "Administrador" : "Vendedor / Caixa")
                            </span>
                        </td>
                        <td><span class="badge @(f.Ativo ? "bg-success" : "bg-secondary")">@(f.Ativo ? "Ativo" : "Desativado")</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                @if (f.Id != Model.UsuarioAtualId)
                                {
                                    <form method="post" asp-page-handler="DefinirAtivo" data-confirm="@(f.Ativo ? $"Desativar o acesso de {f.Nome}?" : $"Reativar o acesso de {f.Nome}?")">
                                        <input type="hidden" name="id" value="@f.Id" />
                                        <input type="hidden" name="ativo" value="@((!f.Ativo).ToString())" />
                                        <button type="submit" class="btn btn-sm @(f.Ativo ? "btn-outline-danger" : "btn-outline-success")">@(f.Ativo ? "Desativar" : "Reativar")</button>
                                    </form>
                                }
                                <a asp-page="Editar" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary" aria-label="Editar @f.Nome">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
