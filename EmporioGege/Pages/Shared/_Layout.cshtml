@using System.Security.Claims
@inject Microsoft.Extensions.Options.IOptions<EmporioGege.Infrastructure.Impressao.ImpressoraOptions> ImpressoraOpcoes
@using EmporioGege.Core.Common
@{
    var nomeLojaImpersonada = User.FindFirst("ImpersonatedTenantNome")?.Value;
    var nomeLoja = nomeLojaImpersonada;
    if (string.IsNullOrWhiteSpace(nomeLoja))
        nomeLoja = User.FindFirst("TenantNome")?.Value;
    if (string.IsNullOrWhiteSpace(nomeLoja))
        nomeLoja = "PendurAi";

    var titulo = ViewData["Title"] as string ?? "Painel";
    var papel = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var papelExibicao = papel switch
    {
        "superadmin" => "Superadmin",
        "administrador" => "Administrador",
        "vendedor" => "Vendedor",
        _ => papel
    };
    var nomeUsuario = User.Identity?.Name ?? "";
    var inicial = string.IsNullOrEmpty(nomeUsuario) ? "?" : nomeUsuario[..1];
    var ehOperador = User.IsInRole("vendedor") || User.IsInRole("administrador") || User.IsInRole("superadmin");
    var ehAdmin = User.IsInRole("administrador") || User.IsInRole("superadmin");
    var ehSuper = User.IsInRole("superadmin");
    var hoje = FusoHorarioBrasil.AgoraLocal().ToString("ddd, dd 'de' MMM", new System.Globalization.CultureInfo("pt-BR"));
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <partial name="_Head" />
    <meta name="pa-impressora-servidor" content="@(ImpressoraOpcoes.Value.Habilitada ? "true" : "false")" />
    <title>@titulo · @nomeLoja</title>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable position-absolute m-2 btn btn-warning" href="#conteudo">Pular para o conteúdo</a>

    <div class="app">
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menu principal">
            <div class="app-brand">
                <div class="app-brand-mark" aria-hidden="true">@nomeLoja[..1].ToUpper()</div>
                <div class="min-w-0 flex-grow-1">
                    <div class="app-brand-name" title="@nomeLoja">@nomeLoja</div>
                    <div class="app-brand-sub">PendurAi</div>
                </div>
                <button type="button" class="icon-btn d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Fechar menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <nav>
                <ul class="app-nav">
                    @if (ehOperador)
                    {
                        <li class="app-nav-label">Operação</li>
                        <li><a href="/Caixa/Index"><i class="bi bi-upc-scan"></i> Frente de caixa</a></li>
                        <li><a href="/Caixa/Comandas"><i class="bi bi-receipt"></i> Comandas</a></li>
                        <li><a href="/Caixa/Turno"><i class="bi bi-safe"></i> Turno de caixa</a></li>
                    }

                    @if (ehAdmin)
                    {
                        <li class="app-nav-label">Gerência</li>
                        <li><a href="/Admin/Index"><i class="bi bi-grid-1x2"></i> Visão geral</a></li>
                        <li><a href="/Admin/Estoque"><i class="bi bi-box-seam"></i> Estoque e produtos</a></li>
                        <li><a href="/Admin/Clientes"><i class="bi bi-people"></i> Clientes e fiado</a></li>
                        <li><a href="/Admin/Vendas"><i class="bi bi-journal-text"></i> Extrato de vendas</a></li>
                        <li><a href="/Admin/Comandas"><i class="bi bi-receipt-cutoff"></i> Histórico de comandas</a></li>
                        <li><a href="/Admin/ProdutosMaisVendidos"><i class="bi bi-bar-chart-line"></i> Mais vendidos</a></li>
                        <li><a href="/Admin/Funcionarios"><i class="bi bi-person-badge"></i> Funcionários</a></li>
                        <li><a href="/Admin/ConfiguracaoFiscal"><i class="bi bi-building"></i> Configuração fiscal</a></li>
                    }

                    @if (ehSuper)
                    {
                        <li class="app-nav-label">Plataforma</li>
                        <li><a href="/SuperAdmin/Index"><i class="bi bi-shield-lock"></i> Painel global</a></li>
                        <li><a href="/SuperAdmin/Adegas"><i class="bi bi-shop"></i> Lojas e licenças</a></li>
                    }
                </ul>
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="icon-btn d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Abrir menu">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="min-w-0">
                    <div class="app-topbar-title">@titulo</div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="app-topbar-date d-none d-md-inline me-1">@hoje</span>
                    <button type="button" class="icon-btn" data-pa-theme-toggle aria-label="Alternar tema">
                        <i data-pa-theme-icon class="bi bi-sun"></i>
                    </button>
                    <div class="dropdown">
                        <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar" aria-hidden="true">@inicial</span>
                            <span class="d-none d-sm-inline text-truncate" style="max-width: 180px;">@nomeUsuario</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li class="px-3 py-2">
                                <div class="small fw-medium text-truncate" style="max-width: 220px;">@nomeUsuario</div>
                                <div class="small text-muted">@papelExibicao</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" action="/Auth/Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> Sair
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(nomeLojaImpersonada))
            {
                <div class="impersonation-bar" role="status">
                    <span class="fw-medium"><i class="bi bi-eye me-2"></i>Você está dentro da loja <strong>@nomeLojaImpersonada</strong></span>
                    <form method="post" action="/SuperAdmin/Adegas?handler=Sair">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning">Sair da loja</button>
                    </form>
                </div>
            }

            <main class="app-content" id="conteudo">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pendurai.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
