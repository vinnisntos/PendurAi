@* Cabeçalho comum a todas as telas: metas, fontes, ícones, Bootstrap e o design system.
   O script inline aplica o tema salvo (ou o do sistema) antes da primeira pintura. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="dark light" />
<link rel="icon" href="~/favicon.ico" sizes="48x48" />
<link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="~/img/brand/apple-touch-icon.png" />
<link rel="manifest" href="~/site.webmanifest" />
<meta name="theme-color" content="#0b0b0d" />
<link rel="preload" href="~/lib/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/lib/geist/geist.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/pendurai.css" asp-append-version="true" />
<script nonce="@ViewContext.HttpContext.Items["csp-nonce"]">
    (function () {
        var t = null;
        try { t = localStorage.getItem("pendurai-tema"); } catch (e) { }
        if (t !== "light" && t !== "dark") {
            t = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-bs-theme", t);
    })();
</script>
