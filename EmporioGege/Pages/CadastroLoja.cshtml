@page
@model EmporioGege.Pages.CadastroLojaModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <partial name="_Head" />
    <meta name="description" content="Cadastre sua adega ou mercado no PendurAi e teste grátis por 7 dias, sem cartão." />
    <title>Cadastre sua loja · PendurAi</title>
</head>
<body>
    <div class="auth-shell">
        <div class="auth-main">
            <div class="auth-top">
                <a asp-page="/Index" class="brand-lockup"><img src="~/img/brand/pendurai-mark.svg" width="28" height="28" alt="" /> <span>Pendur<span class="text-warning">Ai</span></span></a>
                <div class="d-flex align-items-center gap-2">
                    <a asp-page="/Auth/Login" class="link-muted d-none d-sm-inline">Já tenho conta</a>
                    <button type="button" class="icon-btn" data-pa-theme-toggle aria-label="Alternar tema"><i data-pa-theme-icon class="bi bi-sun"></i></button>
                </div>
            </div>

            <div class="auth-center">
                <main class="auth-card is-wide">
                    @if (Model.ExibirSucesso)
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-check-circle text-success d-block mb-3" style="font-size: 2.5rem;"></i>
                            <h1>Cadastro recebido</h1>
                            <p class="lead-sm mx-auto" style="max-width: 52ch;">@Model.MensagemSucesso</p>
                            <a asp-page="/Auth/Login" class="btn btn-warning px-4">Fazer login</a>
                        </div>
                    }
                    else
                    {
                        <h1>Cadastre sua loja</h1>
                        <p class="lead-sm">7 dias grátis em qualquer plano. Você não paga nada agora.</p>

                        @if (!string.IsNullOrEmpty(Model.MensagemErro))
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>@Model.MensagemErro
                            </div>
                        }

                        <form method="post" novalidate>
                            <input type="hidden" asp-for="AbertoEm" />
                            <div class="visually-hidden" aria-hidden="true">
                                <label for="Website">Não preencha este campo</label>
                                <input asp-for="Website" tabindex="-1" autocomplete="off" />
                            </div>
                            <h2 class="form-section-title">Dados da loja</h2>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label asp-for="NomeFantasia" class="form-label">Nome da loja</label>
                                    <input asp-for="NomeFantasia" class="form-control" placeholder="Adega do Bairro" autocomplete="organization" />
                                    <span asp-validation-for="NomeFantasia" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="Cnpj" class="form-label">CNPJ</label>
                                    <input asp-for="Cnpj" class="form-control" placeholder="00.000.000/0001-00" inputmode="numeric" />
                                    <span asp-validation-for="Cnpj" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CidadeEstado" class="form-label">Cidade / Estado</label>
                                    <input asp-for="CidadeEstado" class="form-control" placeholder="Sorocaba / SP" />
                                    <span asp-validation-for="CidadeEstado" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <h2 class="form-section-title">Seus dados de acesso</h2>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label asp-for="NomeRepresentante" class="form-label">Nome completo</label>
                                    <input asp-for="NomeRepresentante" class="form-control" autocomplete="name" />
                                    <span asp-validation-for="NomeRepresentante" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-5">
                                    <label asp-for="CpfRgDono" class="form-label">CPF ou RG</label>
                                    <input asp-for="CpfRgDono" class="form-control" />
                                    <span asp-validation-for="CpfRgDono" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TelefoneDono" class="form-label">Telefone</label>
                                    <input asp-for="TelefoneDono" class="form-control" placeholder="(15) 90000-0000" inputmode="tel" autocomplete="tel" />
                                    <span asp-validation-for="TelefoneDono" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="EmailDono" class="form-label">E-mail (será seu login)</label>
                                    <input asp-for="EmailDono" type="email" class="form-control" autocomplete="email" />
                                    <span asp-validation-for="EmailDono" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Senha" class="form-label">Senha</label>
                                    <input asp-for="Senha" type="password" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="Senha" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmarSenha" class="form-label">Confirmar senha</label>
                                    <input asp-for="ConfirmarSenha" type="password" class="form-control" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmarSenha" class="invalid-feedback d-block"></span>
                                </div>
                            </div>

                            <h2 class="form-section-title">Plano</h2>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="choice">
                                        <input type="radio" asp-for="Plano" value="start" class="form-check-input" />
                                        <span class="choice-title">Start</span>
                                        <span class="choice-meta">R$ 119/mês</span>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="choice">
                                        <input type="radio" asp-for="Plano" value="pro" class="form-check-input" />
                                        <span class="choice-title">Pro</span>
                                        <span class="choice-meta">R$ 199/mês</span>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <label class="choice">
                                        <input type="radio" asp-for="Plano" value="enterprise" class="form-check-input" />
                                        <span class="choice-title">Enterprise</span>
                                        <span class="choice-meta">R$ 349/mês</span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Plano" class="invalid-feedback d-block"></span>

                            <h2 class="form-section-title">Como prefere pagar depois do teste</h2>
                            <p class="small text-muted mt-n1 mb-2">Só usamos isso para gerar a cobrança quando os 7 dias acabarem.</p>
                            <div class="row g-2 mb-4">
                                <div class="col-4">
                                    <label class="choice"><input type="radio" asp-for="TipoCobranca" value="PIX" class="form-check-input" /> <span class="choice-title">Pix</span></label>
                                </div>
                                <div class="col-4">
                                    <label class="choice"><input type="radio" asp-for="TipoCobranca" value="BOLETO" class="form-check-input" /> <span class="choice-title">Boleto</span></label>
                                </div>
                                <div class="col-4">
                                    <label class="choice"><input type="radio" asp-for="TipoCobranca" value="CREDIT_CARD" class="form-check-input" /> <span class="choice-title">Cartão</span></label>
                                </div>
                            </div>
                            <span asp-validation-for="TipoCobranca" class="invalid-feedback d-block mb-3"></span>

                            <button type="submit" class="btn btn-warning w-100 py-2">Começar teste grátis</button>
                            <p class="small text-muted text-center mt-3 mb-0">Sem cartão de crédito. Cancele quando quiser.</p>
                        </form>
                    }
                </main>
            </div>

            <a asp-page="/Index" class="link-muted"><i class="bi bi-arrow-left me-1"></i> Voltar para o site</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/pendurai.js" asp-append-version="true"></script>
</body>
</html>
